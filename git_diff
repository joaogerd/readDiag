+def _needs_swap_dtype(dt: np.dtype) -> bool:
+    """Retorna True se dtype (simples ou estruturado) tem qualquer parte non-native endian."""
+    native = '<' if sys.byteorder == 'little' else '>'
+    if dt.fields is None:
+        # dtype simples
+        return dt.byteorder not in ('=', '|', native)
+    # dtype estruturado: checa cada subcampo
+    for name, (subdt, _offset) in dt.fields.items():
+        bo = subdt.byteorder
+        if bo in ('|', '='):
+            continue
+        if bo != native:
+            return True
+    return False
+
+def _fix_endian(arr: np.ndarray) -> np.ndarray:
+    """
+    Converte array (simples ou estruturado) para endianness nativa.
+    Idempotente. Compatível com NumPy <2.0 e >=2.0.
+    """
+    dt = arr.dtype
+    if not _needs_swap_dtype(dt):
+        return arr
+    swapped = arr.byteswap(inplace=False)
+    try:
+        # NumPy >= 1.20+: usa dtype.newbyteorder('=')
+        return swapped.view(dt.newbyteorder('='))
+    except Exception:
+        # Compat: ndarray.newbyteorder pode existir em versões antigas
+            return swapped.newbyteorder('=')
+
