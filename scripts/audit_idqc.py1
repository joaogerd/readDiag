#!/usr/bin/env python3
from __future__ import annotations

import argparse
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable, Optional

import numpy as np
import pandas as pd

from readDiag.reader import diagAccess


@dataclass(frozen=True)
class Finding:
    file: str
    kind: str           # "rad" ou "conv"
    var_or_sensor: str  # var (conv) ou sensor (rad)
    kx_or_channel: str  # kx (conv) ou canal (rad)
    total: int
    non_integer: int
    frac_unique: str    # exemplos únicos (até N)
    note: str = ""


def _is_integer_like(s: pd.Series, tol: float) -> pd.Series:
    v = pd.to_numeric(s, errors="coerce")
    return v.isna() | (np.abs(v - np.rint(v)) <= tol)


def _expand_paths(patterns: Iterable[str]) -> list[Path]:
    out: list[Path] = []
    for p in patterns:
        path = Path(p)
        if path.exists():
            out.append(path)
        else:
            out.extend(Path().glob(p))
    return sorted(set(out))


def _choose_qc_column(df: pd.DataFrame) -> Optional[str]:
    # Prefer official name from Fortran ('qcmark'); fallback to old label ('idqc')
    if "qcmark" in df.columns:
        return "qcmark"
    if "idqc" in df.columns:
        return "idqc"
    return None


def _collect_conv(rd: diagAccess, tol: float, sample_n: int,
                  findings: list[Finding], samples: list[pd.DataFrame]) -> None:
    data: dict[str, dict[int, pd.DataFrame]] = rd.get_data_frame()
    for var, by_kx in data.items():
        for kx, df in by_kx.items():
            col = _choose_qc_column(df)
            if not col:
                # Em conv, QC costuma ser pbqc/emark… mas seguimos a checagem caso exista qcmark/idqc
                continue
            mask = ~_is_integer_like(df[col], tol)
            if mask.any():
                vals = (df.loc[mask, col]
                        .dropna().astype(float).unique().tolist())
                examples = ", ".join(f"{x:g}" for x in vals[:sample_n])
                findings.append(Finding(
                    file=rd.file_name, kind="conv", var_or_sensor=var,
                    kx_or_channel=str(kx), total=len(df),
                    non_integer=int(mask.sum()), frac_unique=examples
                ))
                # Amostras com contexto
                keep_cols = [c for c in ["lat", "lon", "time", col] if c in df.columns]
                if keep_cols:
                    samp = df.loc[mask, keep_cols].head(sample_n).copy()
                    samp.insert(0, "file", rd.file_name)
                    samp.insert(1, "kind", "conv")
                    samp.insert(2, "var_or_sensor", var)
                    samp.insert(3, "kx_or_channel", kx)
                    samples.append(samp)


def _collect_rad(rd: diagAccess, tol: float, sample_n: int,
                 findings: list[Finding], samples: list[pd.DataFrame]) -> None:
    pack = rd.get_data_frame()
    sensor = pack.get("sensor", "")
    df_list: list[pd.DataFrame] = pack["dataframes"]["diagbufchan_df"]
    for ch, df in enumerate(df_list):
        if not isinstance(df, pd.DataFrame) or df.empty:
            continue
        col = _choose_qc_column(df)
        if not col:
            continue
        mask = ~_is_integer_like(df[col], tol)
        if mask.any():
            vals = (df.loc[mask, col]
                    .dropna().astype(float).unique().tolist())
            examples = ", ".join(f"{x:g}" for x in vals[:sample_n])
            findings.append(Finding(
                file=rd.file_name, kind="rad", var_or_sensor=str(sensor),
                kx_or_channel=str(ch), total=len(df),
                non_integer=int(mask.sum()), frac_unique=examples
            ))
            keep_cols = [c for c in ["lat", "lon", "time", col] if c in df.columns]
            if keep_cols:
                samp = df.loc[mask, keep_cols].head(sample_n).copy()
                samp.insert(0, "file", rd.file_name)
                samp.insert(1, "kind", "rad")
                samp.insert(2, "var_or_sensor", str(sensor))
                samp.insert(3, "kx_or_channel", ch)
                samples.append(samp)


def audit(paths: list[Path], tol: float, sample_n: int) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    findings: list[Finding] = []
    samples: list[pd.DataFrame] = []
    errors: list[Finding] = []

    for p in paths:
        try:
            rd = diagAccess(str(p))
            if rd.get_data_type() == 1:
                _collect_conv(rd, tol, sample_n, findings, samples)
            else:
                _collect_rad(rd, tol, sample_n, findings, samples)
        except Exception as exc:
            errors.append(Finding(
                file=str(p), kind="?", var_or_sensor="?", kx_or_channel="?",
                total=0, non_integer=0, frac_unique="", note=f"read error: {exc!r}"
            ))

    # detalhado
    det_cols = ["file", "kind", "var_or_sensor", "kx_or_channel",
                "total", "non_integer", "frac_unique", "note"]
    df_det = pd.DataFrame([f.__dict__ for f in findings + errors], columns=det_cols)
    if not df_det.empty:
        df_det["pct_non_integer"] = np.where(
            df_det["total"] > 0, 100.0 * df_det["non_integer"] / df_det["total"], np.nan
        ).round(3)
        df_det = df_det.sort_values(["non_integer", "pct_non_integer"],
                                    ascending=False, ignore_index=True)

    # resumo por arquivo/sensor|var
    if not df_det.empty:
        df_sum = (df_det.groupby(["file", "kind", "var_or_sensor"], dropna=False)
                  .agg(total=("total", "sum"),
                       non_integer=("non_integer", "sum"))
                  .reset_index())
        df_sum["pct_non_integer"] = np.where(
            df_sum["total"] > 0, 100.0 * df_sum["non_integer"] / df_sum["total"], np.nan
        ).round(3)
        df_sum = df_sum.sort_values(["pct_non_integer", "non_integer"], ascending=False, ignore_index=True)
    else:
        df_sum = pd.DataFrame(columns=["file", "kind", "var_or_sensor", "total", "non_integer", "pct_non_integer"])

    # amostras
    df_samples = pd.concat(samples, ignore_index=True) if samples else pd.DataFrame(
        columns=["file", "kind", "var_or_sensor", "kx_or_channel", "lat", "lon", "time", "value"]
    )

    return df_det, df_sum, df_samples


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Audit GSI diagnostics to find non-integer-like QC marks (qcmark/idqc)."
    )
    ap.add_argument("inputs", nargs="+", help="Arquivos ou globs (ex.: diag_*2020*)")
    ap.add_argument("--tol", type=float, default=1e-6, help="Tolerância para considerar inteiro (default: 1e-6)")
    ap.add_argument("--sample-n", type=int, default=5, help="Qtde de exemplos únicos e linhas de amostra (default: 5)")
    ap.add_argument("--outdir", type=Path, default=Path("data_processed"),
                    help="Diretório de saída (default: data_processed)")
    args = ap.parse_args()

    paths = _expand_paths(args.inputs)
    if not paths:
        print("[ERRO] Nenhum arquivo encontrado.")
        raise SystemExit(2)

    det, summ, smp = audit(paths, tol=args.tol, sample_n=args.sample_n)

    args.outdir.mkdir(parents=True, exist_ok=True)
    det_path = args.outdir / "qcmark_audit_details.csv"
    sum_path = args.outdir / "qcmark_audit_summary.csv"
    smp_path = args.outdir / "qcmark_audit_samples.csv"

    det.to_csv(det_path, index=False)
    summ.to_csv(sum_path, index=False)
    smp.to_csv(smp_path, index=False)

    # Resumo no terminal
    if det.empty:
        print("[OK] Não foram encontrados valores fracionários em qcmark/idqc.")
    else:
        show = det[["file", "kind", "var_or_sensor", "kx_or_channel", "total", "non_integer", "pct_non_integer", "frac_unique"]]
        with pd.option_context("display.max_colwidth", 60):
            print(show.to_string(index=False))
        print(f"\n[INFO] Salvo: {det_path}")
        print(f"[INFO] Salvo: {sum_path}")
        print(f"[INFO] Salvo: {smp_path}")


if __name__ == "__main__":
    main()

